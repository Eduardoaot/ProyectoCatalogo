# ---- Servidor ----
PORT=3000
NODE_ENV=development

# Origenes permitidos por CORS (separados por coma, * para permitir todos)
CORS_ORIGIN=http://localhost:5173

# ---- Base de datos MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=tienda
DB_CONNECTION_LIMIT=10

# ---- Autenticacion ----
# Cambiar por una cadena larga y aleatoria en produccion
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRES_IN=2h
BCRYPT_SALT_ROUNDS=10
