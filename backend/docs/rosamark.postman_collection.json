    {
      "name": "Clientes",
      "item": [
        {
          "name": "Registro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "if (cuerpo.ok && cuerpo.data.token) {",
                  "  pm.collectionVariables.set('token', cuerpo.data.token);",
                  "  pm.collectionVariables.set('ID_cliente', String(cuerpo.data.cliente.ID_cliente));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_cliente\": \"Ana Perez\",\n  \"correo_cliente\": \"ana@correo.com\",\n  \"contrasena_cliente\": \"MiClave12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/clientes/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes",
                "registro"
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "if (cuerpo.ok && cuerpo.data.token) {",
                  "  pm.collectionVariables.set('token', cuerpo.data.token);",
                  "  pm.collectionVariables.set('ID_cliente', String(cuerpo.data.cliente.ID_cliente));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_cliente\": \"diana@rosamark.com\",\n  \"contrasena_cliente\": \"rosamark123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/clientes/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes",
                "login"
              ]
            }
          }
        },
        {
          "name": "Perfil (me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clientes/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes",
                "me"
              ]
            }
          }
        },
        {
