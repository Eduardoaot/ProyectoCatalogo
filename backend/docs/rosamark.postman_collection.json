          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "if (cuerpo.ok && cuerpo.data.ID_orden) {",
                  "  pm.collectionVariables.set('ID_orden', String(cuerpo.data.ID_orden));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"ID_producto\": 1, \"cantidad\": 2 },\n    { \"ID_producto\": 2, \"cantidad\": 3 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ordenes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordenes"
              ]
            }
          }
        },
